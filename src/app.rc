#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Options...", ID_FILE_OPTIONS
        MENUITEM "&Background Color...", ID_FILE_BACKGROUND
        MENUITEM SEPARATOR
        MENUITEM "Register as Image Viewer...", ID_FILE_REGISTER
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_FILE_EXIT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "^O", ID_FILE_OPEN
END

IDD_OPTIONS DIALOGEX 0, 0, 236, 96
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Zoom per wheel notch:", IDC_STATIC, 10, 12, 86, 9
    EDITTEXT        IDC_ZOOMSTEP, 100, 10, 44, 13, ES_AUTOHSCROLL
    LTEXT           "x  (1.01 - 3.00)", IDC_ZOOMHINT, 150, 12, 78, 9
    LTEXT           "Background:", IDC_STATIC, 10, 34, 86, 9
    PUSHBUTTON      "Choose...", IDC_BGCHOOSE, 100, 31, 52, 14
    LTEXT           "#000000", IDC_BGHEX, 158, 34, 70, 9
    LTEXT           "Initial sizing:", IDC_STATIC, 10, 56, 86, 9
    CONTROL         "Fit to window", IDC_SIZING_FIT, "Button", BS_AUTORADIOBUTTON | WS_GROUP,
                    100, 54, 120, 10
    CONTROL         "Actual size (100%)", IDC_SIZING_ACTUAL, "Button", BS_AUTORADIOBUTTON,
                    100, 70, 120, 10
    DEFPUSHBUTTON   "OK", IDOK, 104, 82, 44, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 154, 82, 44, 14
END

IDD_BACKGROUND DIALOGEX 0, 0, 196, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Background Alpha"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Alpha (0-255):", IDC_STATIC, 10, 12, 52, 9
    CONTROL         "", IDC_BG_A, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS, 64, 10, 92, 14
    EDITTEXT        IDC_BG_AEDIT, 162, 10, 24, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Preview (composited over black)", IDC_STATIC, 10, 32, 176, 9
    CTEXT           "", IDC_BG_PREVIEW, 10, 44, 86, 28, WS_BORDER
    LTEXT           "0 is black, 255 is the full colour. The image itself is drawn on top.",
                    IDC_STATIC, 104, 44, 86, 28
    DEFPUSHBUTTON   "OK", IDOK, 102, 76, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 146, 76, 40, 14
END

1 RT_MANIFEST "app.manifest"
