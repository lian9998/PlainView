#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "app.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Options...", ID_FILE_OPTIONS
        MENUITEM "&Background Color...", ID_FILE_BACKGROUND
        MENUITEM SEPARATOR
        MENUITEM "Register as Image Viewer...", ID_FILE_REGISTER
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_FILE_EXIT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "^O", ID_FILE_OPEN
END

IDD_OPTIONS DIALOGEX 0, 0, 264, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Zoom per wheel notch:", IDC_STATIC, 10, 12, 86, 9
    EDITTEXT        IDC_ZOOMSTEP, 100, 10, 44, 13, ES_AUTOHSCROLL
    LTEXT           "x  (1.01 - 3.00)", IDC_ZOOMHINT, 150, 12, 106, 9
    LTEXT           "Background:", IDC_STATIC, 10, 32, 86, 9
    PUSHBUTTON      "Choose...", IDC_BGCHOOSE, 100, 29, 52, 14
    LTEXT           "#000000", IDC_BGHEX, 158, 32, 98, 9
    LTEXT           "Image cache:", IDC_STATIC, 10, 52, 86, 9
    CONTROL         "", IDC_CACHE, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 100, 48, 104, 17
    LTEXT           "256 MB", IDC_CACHELABEL, 208, 52, 48, 9
    LTEXT           "16 MB", IDC_CACHEMIN, 100, 65, 40, 9
    RTEXT           "128 GB", IDC_CACHEMAX, 164, 65, 40, 9
    LTEXT           "about 67 screen-sized images", IDC_CACHEHINT, 100, 77, 156, 9
    CONTROL         "No limit (let Windows decide)", IDC_CACHEUNLIMITED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 100, 89, 156, 10
    LTEXT           "Prefetch each way:", IDC_STATIC, 10, 108, 86, 9
    EDITTEXT        IDC_PREFETCH, 100, 106, 28, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "0 - 20  (0 disables)", IDC_PREFETCHHINT, 132, 108, 116, 9
    LTEXT           "Initial sizing:", IDC_STATIC, 10, 127, 86, 9
    CONTROL         "Fit to window", IDC_SIZING_FIT, "Button", BS_AUTORADIOBUTTON | WS_GROUP,
                    100, 125, 150, 10
    CONTROL         "Actual size (100%)", IDC_SIZING_ACTUAL, "Button", BS_AUTORADIOBUTTON,
                    100, 139, 150, 10
    GROUPBOX        "Mouse and keyboard", IDC_STATIC, 8, 151, 248, 41
    CONTROL         "Double-click toggles fill and fit", IDC_DOUBLECLICK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 164, 232, 10
    CONTROL         "Esc twice quits", IDC_DOUBLEESC, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 177, 232, 10
    DEFPUSHBUTTON   "OK", IDOK, 132, 198, 44, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 198, 44, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLAINVIEW_VERSION_MAJOR,PLAINVIEW_VERSION_MINOR,PLAINVIEW_VERSION_PATCH,0
 PRODUCTVERSION PLAINVIEW_VERSION_MAJOR,PLAINVIEW_VERSION_MINOR,PLAINVIEW_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PlainView contributors"
            VALUE "FileDescription", "PlainView - a minimal Windows image viewer"
            VALUE "FileVersion", PLAINVIEW_VERSION_STRING
            VALUE "InternalName", "PlainView"
            VALUE "LegalCopyright", "GPL-3.0. Copyright (C) 2026 PlainView contributors."
            VALUE "OriginalFilename", "PlainView.exe"
            VALUE "ProductName", "PlainView"
            VALUE "ProductVersion", PLAINVIEW_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 RT_MANIFEST "app.manifest"
